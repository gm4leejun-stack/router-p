ROUTER_P_APP_NAME=Router-P
ROUTER_P_APP_VERSION=0.1.0
ROUTER_P_ENVIRONMENT=development
ROUTER_P_HOST=0.0.0.0
ROUTER_P_PORT=8000
ROUTER_P_LOG_LEVEL=info

ROUTER_P_API_KEY=dev-router-p-key
ROUTER_P_REQUEST_TIMEOUT_SECONDS=30

# Ollama runs outside Docker Compose by default.
# On macOS/Windows Docker Desktop, host.docker.internal usually reaches the host.
ROUTER_P_OLLAMA_BASE_URL=http://host.docker.internal:11434
ROUTER_P_LOCAL_BOUNDARY_MODEL=phi4-mini
ROUTER_P_LOCAL_GENERAL_MODEL=qwen3:4b
ROUTER_P_LOCAL_CODE_MODEL=qwen2.5-coder:7b

# Optional cloud provider settings.
ROUTER_P_CLOUD_BASE_URL=
ROUTER_P_CLOUD_API_KEY=
ROUTER_P_CLOUD_GENERAL_MODEL=
ROUTER_P_CLOUD_CODE_MODEL=
